PORT=3001
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
JWT_SECRET=your_jwt_secret
NODE_ENV=development
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=uploads
STORAGE_S3_ENDPOINT=https://<your-account-id>.r2.cloudflarestorage.com
STORAGE_S3_REGION=auto
STORAGE_S3_BUCKET=your-private-bucket
STORAGE_S3_ACCESS_KEY_ID=your-r2-access-key
STORAGE_S3_SECRET_ACCESS_KEY=your-r2-secret-key
MAX_DOCUMENT_SIZE_MB=10
# Solo para el script destructivo de sincronizacion, nunca para el servidor.
MIGRATION_DEST_HOST=localhost
MIGRATION_DEST_USER=your_destination_user
MIGRATION_DEST_PASSWORD=your_destination_password
MIGRATION_DEST_NAME=your_destination_database
MIGRATION_ORIG_HOST=localhost
MIGRATION_ORIG_USER=your_origin_user
MIGRATION_ORIG_PASSWORD=your_origin_password
MIGRATION_ORIG_NAME=your_origin_database
# Nunca activar en produccion salvo una prueba controlada.
ALLOW_DEMO_SEED=false
